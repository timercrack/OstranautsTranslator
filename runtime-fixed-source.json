    { "raw_text": "Switch to Comms Controls", "seed_translations": { "zh": "切换到通讯控制" } },
    { "raw_text": "Switch to Nav Screen", "seed_translations": { "zh": "切换到导航界面" } },
    { "raw_text": "Take The Goods", "seed_translations": { "zh": "拿走物资" } },
    { "raw_text": "Target K-Leg Station", "seed_translations": { "zh": "锁定 K-Leg 空间站" } },
    { "raw_text": "Target the closest Derelict", "seed_translations": { "zh": "锁定最近的废船" } },
    { "raw_text": "Toggle Off MatchSpeed", "seed_translations": { "zh": "关闭匹配速度" } },
