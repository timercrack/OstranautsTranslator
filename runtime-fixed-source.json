    { "raw_text": "Toggle Wear & Tear Info", "seed_translations": { "zh": "切换磨损信息" } },
    { "raw_text": "Travel to Docking Range", "seed_translations": { "zh": "航行至对接范围" } },
    { "raw_text": "Tutorial Complete", "seed_translations": { "zh": "教程完成" } },
    { "raw_text": "Tutorial Stub", "seed_translations": { "zh": "教程占位" } },
    { "raw_text": "Unpaid Docking Fees", "seed_translations": { "zh": "未支付停靠费" } },
    { "raw_text": "Unpause World", "seed_translations": { "zh": "恢复时间流逝" } },
    { "raw_text": "Use the Nav Station", "seed_translations": { "zh": "使用导航站" } },
    { "raw_text": "Visit Your Ship", "seed_translations": { "zh": "前往你的飞船" } },
    { "raw_text": "Visualize Power Networks", "seed_translations": { "zh": "显示电力网络" } },
    { "raw_text": "Use rotation controls until the ship is pointing towards OKLG (BRG near 0, with OKLG targeted).", "seed_translations": { "zh": "使用旋转控制，直到飞船朝向 OKLG（已锁定 OKLG，BRG 接近 0）。" } },
    { "raw_text": "Fill in the description text of the objective!", "seed_translations": { "zh": "填写目标的说明文本！" } },
    { "raw_text": "Open the inventory of the nearby rack. Move the tote into your bag slot, then place the suit and helmet in the tote inventory.", "seed_translations": { "zh": "打开附近货架的物品栏。把手提包移到背包槽位，再将压力服和头盔放进手提包的物品栏中。" } },
    { "raw_text": "This isn't the direct route to your ship. But sometimes venturing off the beaten path pays dividends.", "seed_translations": { "zh": "这不是通往你飞船的正路。但有时候偏离常轨会带来回报。" } },
    { "raw_text": "Try toggling the switch at the end of the hallway.", "seed_translations": { "zh": "试着拨动走廊尽头的开关。" } },
    { "raw_text": "Now the door is powered, pick up your reward on the far side.", "seed_translations": { "zh": "现在舱门已经通电，去另一侧拿你的奖励。" } },
    { "raw_text": "There's an unpowered door connecting back to the rest of K-LEG. Pry it open with the crowbar.", "seed_translations": { "zh": "有一扇没通电的门与 K-LEG 的其余区域相连。用撬棍把它撬开。" } },
    { "raw_text": "Press on the paper Cheat Sheet note to move it aside.", "seed_translations": { "zh": "点击那张纸质备忘单，把它挪到一边。" } },
    { "raw_text": "Use the same flight controls to approach the docking ring below 100 m/s VREL, RNG near zero, align docking rings, then press CLAMPS when the \"CLAMP ALIGN\" light is green.", "seed_translations": { "zh": "使用同样的飞行控制，以低于 100 m/s 的相对速度接近对接环，让 RNG 接近零、对齐对接环，并在“锁扣对准”指示灯变绿时按下“锁扣”按钮。" } },
    { "raw_text": "Press 'Show more' to view detailed information about the selected item, such as gas composition, temperature, and pressure.", "seed_translations": { "zh": "按“显示更多”查看所选物品的详细信息，例如气体成分、温度和压力。" } },
    { "raw_text": "Move the handheld lamp into your hand, toggle it on. Step into the derelict.", "seed_translations": { "zh": "把手持灯拿到手上并打开，然后走进废船。" } },
    { "raw_text": "Select \"Hail Ship\", choose the closest \"?\", and initiate docking procedure to dock with the derelict.", "seed_translations": { "zh": "选择“呼叫飞船”，选中最近的“？”，然后发起对接流程，与废船对接。" } },
    { "raw_text": "Move the yellow jumpsuit and shoes on the ground onto your character in the inventory screen.", "seed_translations": { "zh": "在物品栏界面中，把地上的黄色连体服和鞋子拖到你的角色身上。" } },
    { "raw_text": "Click the \"Hail Ship\" button on the right side of the Comms console. Select \"OKLG\" from the list of contacts.", "seed_translations": { "zh": "点击通讯控制台右侧的“呼叫飞船”按钮。从联系人列表中选择“OKLG”。" } },
    { "raw_text": "Select the Install action from the Quick Action Bar.", "seed_translations": { "zh": "从快捷操作栏中选择“安装”动作。" } },
    { "raw_text": "Installation takes time. Remember you can speed up time when attempting long tasks.", "seed_translations": { "zh": "安装需要时间。尝试长时间任务时，记得你可以加速时间。" } },
    { "raw_text": "Installing the Conduit restored power to the door. Search the room beyond for your reward.", "seed_translations": { "zh": "安装导管后，舱门恢复了供电。去后面的房间寻找你的奖励。" } },
    { "raw_text": "It's somewhere in the dark ...", "seed_translations": { "zh": "它就在黑暗中的某处……" } },
    { "raw_text": "That was an instructive diversion. You've learned much. Continue onwards to your ship at the dock.", "seed_translations": { "zh": "这段岔路很有启发性。你学到了不少东西。继续前往停靠在码头的飞船吧。" } },
    { "raw_text": "Find a room with safe levels of O2 (20 kPa+) & CO2 (<1 kPa) and remove your helmet.", "seed_translations": { "zh": "找一个氧气高于 20 kPa、CO2 低于 1 kPa 的安全房间，然后摘下头盔。" } },
    { "raw_text": "Whoever's this was, they don't need it anymore. Take what you can from the lockers.", "seed_translations": { "zh": "不管这原本是谁的，他已经用不上了。把储物柜里能拿的都拿走。" } },
    { "raw_text": "Walk through OKLG station. Board your ship docked at the airlock.", "seed_translations": { "zh": "穿过 OKLG 空间站。登上停靠在气闸处的你的飞船。" } },
    { "raw_text": "Press the capsule button displaying your money and pay your docking fees through the finances window.", "seed_translations": { "zh": "点击显示你资金的胶囊按钮，并在财务窗口中支付停靠费。" } },
    { "raw_text": "Place the nearby yellow toolbox in your hand slot.", "seed_translations": { "zh": "把附近的黄色工具箱放到你的手持槽位里。" } },
    { "raw_text": "Leave the nav station, open inventory, remove your jumpsuit and shoes, and put on your pressure suit and helmet.", "seed_translations": { "zh": "离开导航站，打开物品栏，脱下连体服和鞋子，然后穿上压力服和头盔。" } },
    { "raw_text": "Uninstall the Conduit via the QAB.", "seed_translations": { "zh": "通过快捷操作栏拆除导管。" } },
    { "raw_text": "Alternatively, if you hunt around, there might be another way past the door ...", "seed_translations": { "zh": "或者，如果你四处找找，也许能找到另一条穿过这扇门的路……" } },
    { "raw_text": "Use the Crowbar to Pry the Bridge door open.", "seed_translations": { "zh": "使用撬棍把舰桥门撬开。" } },
    { "raw_text": "Walk through door.", "seed_translations": { "zh": "穿过舱门。" } },
    { "raw_text": "Open your vizor and identify the missing circuit link. Install the Loose Conduit to run power to the Bridge Door.", "seed_translations": { "zh": "打开你的视镜，找出缺失的电路连接。安装松脱的导管，为舰桥门供电。" } },
    { "raw_text": "Provide power to the door down the long hallway. \"Borrow\" excess conduit, if necessary.", "seed_translations": { "zh": "给长走廊尽头的门供电。如有必要，就“借用”多余的导管。" } },
    { "raw_text": "Visit the orange \"Docking and Refuel Services\" kiosk and refuel your ship.", "seed_translations": { "zh": "前往橙色的“Docking and Refuel Services”终端，为你的飞船补充燃料。" } },
    { "raw_text": "Select \"Request undocking clearance\". Finally, to undock, press the CLAMPS button.", "seed_translations": { "zh": "选择“请求离港许可”。最后，要脱离泊位时，按下“锁扣”按钮解除对接。" } },
    { "raw_text": "Provide power to the door by installing the loose conduit into the gap nearby.", "seed_translations": { "zh": "通过将松脱的导管安装到旁边的缺口中，为舱门供电。" } },
    { "raw_text": "Fly back and dock with OKLG station in order to sell your salvage.", "seed_translations": { "zh": "飞回 OKLG 空间站并与其对接，以便出售你的打捞物。" } },
    { "raw_text": "Open the Roster UI and change the airlock permissions", "seed_translations": { "zh": "打开成员界面并更改气闸权限。" } },
    { "raw_text": "Visit the yellow licensed kiosk, or gray scrap kiosk, and sell any item.", "seed_translations": { "zh": "前往黄色持证终端或灰色废品终端，卖掉任意物品。" } },
    { "raw_text": "Click \"Switch to Nav Controls\" on the left side of the console to return to Nav controls.", "seed_translations": { "zh": "点击控制台左侧的“切换到导航控制”按钮，返回导航控制界面。" } },
    { "raw_text": "Zoom out. Find the Nav contact marked TUTORIAL DERELICT in the boneyard. Select it.", "seed_translations": { "zh": "缩小视野。在残骸场中找到标记为“教程废船”的导航目标并选中它。" } },
    { "raw_text": "Press on the white diamond labeled OKLG to target it and get detailed info.", "seed_translations": { "zh": "点击标有 OKLG 的白色菱形，将其锁定并查看详细信息。" } },
    { "raw_text": "Remember to turn off match speed before moving the ship again.", "seed_translations": { "zh": "记得在再次移动飞船之前先关闭速度匹配。" } },
    { "raw_text": "Travel to within RNG < 5 km of your target, and slow down until VREL is below 100 m/s (with destination targeted).", "seed_translations": { "zh": "航行至距离目标 RNG 小于 5 km 的范围，并将相对速度减至 100 m/s 以下（已锁定目的地）。" } },
    { "raw_text": "You have reached the end of the tutorial. From here, the stars your destination.", "seed_translations": { "zh": "你已经到达教程的终点。从这里开始，群星就是你的目的地。" } },
    { "raw_text": "This is the end of the tutorial development sequence.", "seed_translations": { "zh": "这里是教程开发流程的结尾。" } },
    { "raw_text": "Visit the Fuel kiosk to pay your docking fees", "seed_translations": { "zh": "前往燃料终端支付你的停靠费。" } },
    { "raw_text": "Zoom the NAV Station's view in or out with with the mouse scrollwheel. Hold the shift key to zoom faster.\n\nZoom in until the range is under 6km.", "seed_translations": { "zh": "使用鼠标滚轮缩放导航站视图。按住 Shift 键可加快缩放。\n\n将视野放大到距离小于 6 km。" } },
    { "raw_text": "Aimed at OKLG.", "seed_translations": { "zh": "已瞄准 OKLG。" } },
